{
  "name": "oh-my-deepseek",
  "version": "0.1.0",
  "description": "Oh-My-DeepSeek: multi-agent orchestration plugins for DeepSeek Harness — ralplan consensus planning, team staged pipeline, and deep-interview requirement clarification.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./ralplan": "./lib/ralplan.js",
    "./team": "./lib/team.js",
    "./deep-interview": "./lib/deep-interview.js",
    "./deep-interview-skill": "./lib/deep-interview-skill.js",
    "./scoring": "./lib/scoring.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/copy-roles.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "link:peers": "node scripts/link-peers.mjs",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-workflow": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.8",
    "tsdown": "^0.22.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  }
}
